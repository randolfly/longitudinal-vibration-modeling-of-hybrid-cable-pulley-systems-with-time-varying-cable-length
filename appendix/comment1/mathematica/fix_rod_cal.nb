Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"U", "[", 
    RowBox[{"x1_", ",", "t1_"}], "]"}], "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"u", "[", 
        RowBox[{"t", ",", "x"}], "]"}], ")"}], "/.", "s"}], ")"}], "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"x", "->", "x1"}], ",", 
      RowBox[{"t", "->", "t1"}]}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Ux", "[", 
    RowBox[{"x1_", ",", "t1_"}], "]"}], "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["\[PartialD]", "x"], 
        RowBox[{"u", "[", 
         RowBox[{"t", ",", "x"}], "]"}]}], ")"}], "/.", "s"}], ")"}], "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"x", "->", "x1"}], ",", 
      RowBox[{"t", "->", "t1"}]}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
