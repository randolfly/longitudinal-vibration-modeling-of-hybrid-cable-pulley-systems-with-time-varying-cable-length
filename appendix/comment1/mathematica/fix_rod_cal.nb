Cell[CellGroupData[{

Cell["Use NDSolve to get the numerical result of PDE", "Subsection",
 CellChangeTimes->{
  3.9382111066164536`*^9, {3.9530050087878914`*^9, 
   3.953005035584476*^9}},ExpressionUUID->"6a2492d5-c02a-49e7-9609-\
cc3aebe9d87a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"s", "=", 
   RowBox[{"NDSolve", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          SubscriptBox["\[PartialD]", 
           RowBox[{"t", ",", "t"}]], 
          RowBox[{"u", "[", 
           RowBox[{"t", ",", "x"}], "]"}]}], "\[Equal]", 
         RowBox[{
          RowBox[{
           SuperscriptBox["a", "2"], 
           RowBox[{
            SubscriptBox["\[PartialD]", 
             RowBox[{"x", ",", "x"}]], 
            RowBox[{"u", "[", 
             RowBox[{"t", ",", "x"}], "]"}]}]}], "+", 
          RowBox[{
           FractionBox["f", "\[Rho]"], 
           RowBox[{"DiracDelta", "[", 
            RowBox[{"x", "-", "l"}], "]"}]}]}]}], ",", 
        RowBox[{
         RowBox[{"u", "[", 
          RowBox[{"0", ",", "x"}], "]"}], "\[Equal]", "0"}], ",", 
        RowBox[{
         RowBox[{
          SuperscriptBox["u", 
           TagBox[
            RowBox[{"(", 
             RowBox[{"1", ",", "0"}], ")"}],
            Derivative],
           MultilineFunction->None], "[", 
          RowBox[{"0", ",", "x"}], "]"}], "\[Equal]", "0"}], ",", 
        RowBox[{
         RowBox[{"u", "[", 
          RowBox[{"t", ",", "0"}], "]"}], "\[Equal]", 
         RowBox[{"u", "[", 
          RowBox[{"t", ",", "L"}], "]"}], "==", "0"}]}], "}"}], "/.", 
      RowBox[{"{", 
       RowBox[{"DiracDelta", "->", 
        RowBox[{"appro", "'"}]}], "}"}]}], ",", "u", ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "T"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "L"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{
  3.938207598977006*^9, 3.938207726004393*^9, {3.93820776571397*^9, 
   3.938207773135005*^9}, 3.9382080464338017`*^9, 3.938208085178625*^9, {
   3.9382081344304476`*^9, 3.9382081353122225`*^9}, {3.93820820358527*^9, 
